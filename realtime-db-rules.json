{
  "rules": {
    "users": {
      "$uid": {
        // Allow reads for everyone, but writes only from an authenticated user that matches the uid
        ".read": true,
        ".write": "auth != null && auth.uid === $uid",
        // Basic validation
        ".validate": "newData.hasChildren(['email','name','role','createdAt']) && newData.child('email').isString() && newData.child('name').isString() && (newData.child('role').val() === 'admin' || newData.child('role').val() === 'staff')"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        // Only server-side or admin scripts should write here; block client writes
        ".write": false
      }
    },
    "staffs": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "test_connection": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}  