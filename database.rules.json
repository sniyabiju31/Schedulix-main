{
  "rules": {
    ".read": true,
    ".write": true,
    "users": {
      ".indexOn": [
        "role",
        "email",
        "registerNo"
      ],
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['email','name','role','createdAt']) && newData.child('email').isString() && newData.child('name').isString() && (newData.child('role').val() === 'admin' || newData.child('role').val() === 'staff' || newData.child('role').val() === 'student' || newData.child('role').val() === 'parent')"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "staffs": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "email"
      ]
    },
    "test_connection": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "students": {
      ".indexOn": [
        "email",
        "rollNo",
        "registerNo"
      ]
    },
    "teachers": {
      ".indexOn": [
        "email",
        "employeeId"
      ]
    },
    "parents": {
      ".indexOn": [
        "email"
      ]
    },
    "subjects": {
      ".indexOn": [
        "semester",
        "code",
        "department"
      ]
    },
    "preferences": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "planner": {
      ".read": true,
      ".write": true
    }
  }
}